# ============================================================
# Jungianship — Environment Variables Template
# ============================================================


# --- Telegram Bot ---
# Create a bot via @BotFather on Telegram and paste the token here.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# --- Google Gemini API ---
# Obtain a free key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_gemini_api_key_here

# --- Generation Model (optional, defaults to gemini-3.7-flash) ---
# Options: models/gemini-3.7-flash, models/gemini-3.8-flash, etc.
GENERATION_MODEL=models/gemini-3.7-flash

# --- Persona Configuration ---
# Change these to adapt the bot to any wise historical figure.
# Example values below are for the default Carl Jung persona.
PERSONA_NAME=Carl Gustav Jung
PERSONA_ERA=1875–1961
PERSONA_ROLE=Swiss psychiatrist and founder of analytical psychology
PERSONA_WORKS=Collected Works, The Red Book, Memories Dreams Reflections, Seminars, and Letters
PERSONA_DOMAIN=analytical psychology, archetypes, the unconscious, individuation, alchemy, and mythology
